<% provide(:title, 'Edit Tag') %>
<h1>Edit Tag</h1>

<div class="row">
  <div class="col-md-6 col-md-offset-3">
    <!-- フォームの再利用がない（DRYの原則に反する） -->
    <%= form_with(model: @tag, local: true) do |f| %>
      <%= f.label :name %>
      <%= f.text_field :name, class: 'form-control' %>
      
      <%= f.label :description %>
      <%= f.text_area :description, class: 'form-control' %>
      
      <%= f.label :color %>
      <%= f.color_field :color, class: 'form-control' %>
      
      <!-- 編集時に作成者を変更可能（ビジネスロジックの問題） -->
      <%= f.label :created_by %>
      <%= f.text_field :created_by, class: 'form-control' %>
      
      <%= f.submit "Update Tag", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<div class="row mt-3">
  <div class="col-md-6 col-md-offset-3">
    <%= link_to "Back to all tags", tags_path %>
    <!-- jQueryを使用して確認ダイアログを表示（現代的でない実装） -->
    <script>
      $(document).ready(function() {
        $('.delete-tag').click(function(e) {
          if (!confirm('Are you sure you want to delete this tag?')) {
            e.preventDefault();
          }
        });
      });
    </script>
  </div>
</div>